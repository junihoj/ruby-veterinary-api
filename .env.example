# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Database (parent repo infrastructure/docker-compose.dev.yml maps host 5433 -> container 5432)
DATABASE_URL=postgresql://ruby:ruby_dev@localhost:5433/ruby_veterinary_dev

# Auth (ADR-0011) - generate real secrets per environment
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Optional providers (S3 from M2; webhook secrets from M3a/M6; empty = endpoint fails closed)
# Object storage is S3-compatible (SeaweedFS in dev, ADR-0016); endpoint e.g. http://localhost:8333
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PAYMENT_WEBHOOK_SECRET=

# AI assistant / RAG (M6). The ai_kb role is created by the m6_ai_kb migration;
# rotate the dev password before any shared deployment.
AI_KB_DATABASE_URL=postgresql://ai_kb_app:ai_kb_dev_password@localhost:5433/ruby_veterinary_dev
# Empty = deterministic offline adapters (dev/e2e). Production must set a key.
OPENAI_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# Chat session lifecycle / abuse limits (M6)
CHAT_SESSION_TTL_MINUTES=45
CHAT_HANDOFF_RETENTION_HOURS=24
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_MESSAGES_PER_SESSION=60
CHAT_RATE_PER_IP_PER_MIN=20
CHAT_RATE_PER_SESSION_PER_MIN=10
CHAT_DAILY_REQUEST_CAP=2000
CHAT_DAILY_TOKEN_CAP=2000000
CHAT_SWEEPER_TICK_MS=300000
AI_INGESTION_TICK_MS=10000

# Telegram staff handoff (M6b). All three must be set to enable the provider.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FORUM_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional Cloudflare Turnstile challenge on POST /chat/session.
TURNSTILE_SECRET_KEY=
