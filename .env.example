# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Database (parent repo infrastructure/docker-compose.dev.yml maps host 5433 -> container 5432)
DATABASE_URL=postgresql://ruby:ruby_dev@localhost:5433/ruby_veterinary_dev

# Auth (ADR-0011) - generate real secrets per environment
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Optional providers (wired from M3a/M6 on; empty in Foundation)
# Object storage is S3-compatible (SeaweedFS in dev, ADR-0016); endpoint e.g. http://localhost:8333
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PAYMENT_WEBHOOK_SECRET=
